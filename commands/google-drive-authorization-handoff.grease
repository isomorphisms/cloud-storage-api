#!/usr/bin/env grease
set -eu
LC_ALL=C
export LC_ALL

script_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${GOOGLE_OAUTH_LOOPBACK:-}" ]; then
    loopback_helper=$GOOGLE_OAUTH_LOOPBACK
elif [ -x "$script_directory/google-oauth-loopback" ]; then
    loopback_helper=$script_directory/google-oauth-loopback
else
    loopback_helper=google-oauth-loopback
fi

fail() {
    printf '%s\n' "$*" >&2
    exit 2
}

validate_number() {
    number_name=$1
    number_value=$2
    case $number_value in
        ''|*[!0-9]*) fail "$number_name is not an unsigned decimal integer" ;;
    esac
}

validate_private_file() {
    private_file=$1
    description=$2
    [ -f "$private_file" ] || fail "$description not found: $private_file"
    [ ! -L "$private_file" ] || fail "$description must not be a symbolic link: $private_file"
    mode=$(stat -c %a -- "$private_file") || fail "cannot inspect $description permissions"
    case $mode in
        *00) ;;
        *) fail "$description must not be accessible by group or other users: $private_file" ;;
    esac
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'google-drive-authorization-handoff needs %s\n' "$1" >&2
        exit 127
    }
}

write_offer() {
    offer_file=$1
    adapter=$2
    control_name=$3
    control_value=$4
    [ ! -e "$offer_file" ] && [ ! -L "$offer_file" ] ||
        fail "handoff offer already exists: $offer_file"
    offer_temporary=$offer_file.tmp.$$
    umask 077
    {
        printf '%s\n' 'schema=google-drive-authorization-handoff-v1'
        printf 'adapter=%s\n' "$adapter"
        printf 'control_name=%s\n' "$control_name"
        printf 'control_value=%s\n' "$control_value"
    } > "$offer_temporary"
    chmod 600 "$offer_temporary"
    mv -- "$offer_temporary" "$offer_file"
}

command_listen() {
    [ "$#" -eq 4 ] ||
        fail 'listen needs PENDING_FILE OFFER_FILE RESULT_FILE TIMEOUT_SECONDS'
    pending_file=$1
    offer_file=$2
    result_file=$3
    timeout_seconds=$4

    validate_private_file "$pending_file" 'OAuth pending file'
    validate_number 'handoff timeout' "$timeout_seconds"
    [ "$timeout_seconds" -ge 1 ] && [ "$timeout_seconds" -le 3600 ] ||
        fail 'handoff timeout must be between 1 and 3600 seconds'
    [ ! -e "$result_file" ] && [ ! -L "$result_file" ] ||
        fail "handoff result already exists: $result_file"
    need_command "$loopback_helper"

    temporary_root=${TMPDIR:-/tmp}
    working=$(mktemp -d "$temporary_root/cloud-storage-authorization-handoff.XXXXXX")
    port_file=$working/port

    "$loopback_helper" listen "$pending_file" "$port_file" "$result_file" "$timeout_seconds" &
    listener_pid=$!

    cleanup() {
        kill "$listener_pid" >/dev/null 2>&1 || :
        wait "$listener_pid" >/dev/null 2>&1 || :
        rm -rf -- "$working"
    }
    trap cleanup EXIT HUP INT TERM

    attempt=0
    while [ ! -f "$port_file" ] && [ "$attempt" -lt 10 ]; do
        if ! kill -0 "$listener_pid" >/dev/null 2>&1; then
            wait "$listener_pid" || :
            fail 'loopback handoff failed before publishing an offer'
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    [ -f "$port_file" ] || fail 'loopback handoff did not publish an offer'

    port=$(sed -n '1p' "$port_file")
    validate_number 'loopback port' "$port"
    [ "${#port}" -le 5 ] || fail 'loopback handoff returned an invalid port'
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] ||
        fail 'loopback handoff returned an invalid port'

    write_offer "$offer_file" loopback port "$port"

    wait "$listener_pid" || exit 1

    state_count=$( { grep -c '^state=' "$pending_file" || :; } )
    [ "$state_count" -eq 1 ] || fail 'OAuth pending file must contain exactly one state field'
    state=$(sed -n 's/^state=//p' "$pending_file")
    [ -n "$state" ] || fail 'OAuth pending file has an empty state field'
    printf 'state=%s\n' "$state" >> "$result_file"

    trap - EXIT HUP INT TERM
    rm -rf -- "$working"
}

case ${1:-} in
    listen)
        shift
        command_listen "$@"
        ;;
    -h|--help|'')
        printf '%s\n'             'usage: google-drive-authorization-handoff listen PENDING_FILE OFFER_FILE RESULT_FILE TIMEOUT_SECONDS'
        ;;
    *)
        fail "unknown handoff action: $1"
        ;;
esac
