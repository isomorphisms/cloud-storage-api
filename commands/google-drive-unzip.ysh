#!/usr/bin/env ysh
set -eu

usage() {
    cat <<'EOF'
usage: google-drive-unzip DRIVE_ZIP [DESTINATION_FOLDER]

Extract a ZIP already stored in Google Drive without downloading it to this
machine. The command invokes a deployed Google Apps Script API executable.

Arguments may be raw Drive IDs or ordinary Drive URLs.

Required environment:
  GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID
      Deployment ID of the API Executable containing unzip_drive_file.

Authentication, choose one:
  GOOGLE_ACCESS_TOKEN
      OAuth 2.0 access token. Keep it out of shell history.
  GOOGLE_ACCESS_TOKEN_FILE
      Path to a private file containing only the access token.

The caller's OAuth client and the Apps Script executable must use the same
standard Google Cloud project. The token must authorize the scopes used by the
script, including Drive access.

stdout: compact JSON result from unzip_drive_file
stderr: diagnostics only
EOF
}

drive_id() {
    value=$1
    case $value in
        *'/d/'*)
            value=${value#*/d/}
            value=${value%%/*}
            ;;
        *'/folders/'*)
            value=${value#*/folders/}
            value=${value%%/*}
            ;;
        *'id='*)
            value=${value#*id=}
            value=${value%%&*}
            ;;
    esac

    value=${value%%\?*}
    value=${value%%\#*}

    if test -z "$value"; then
        printf '%s\n' 'empty Google Drive id' >&2
        return 2
    fi

    printf '%s\n' "$value"
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'google-drive-unzip needs %s\n' "$1" >&2
        exit 127
    }
}

case ${1:-} in
    -h|--help)
        usage
        exit 0
        ;;
esac

if test "$#" -lt 1 || test "$#" -gt 2; then
    usage >&2
    exit 2
fi

deployment_id=${GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID:-}
if test -z "$deployment_id"; then
    printf '%s\n' 'GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID is required' >&2
    exit 2
fi

token=${GOOGLE_ACCESS_TOKEN:-}
if test -z "$token" && test -n "${GOOGLE_ACCESS_TOKEN_FILE:-}"; then
    token=$(cat -- "$GOOGLE_ACCESS_TOKEN_FILE")
fi
if test -z "$token"; then
    printf '%s\n' 'set GOOGLE_ACCESS_TOKEN or GOOGLE_ACCESS_TOKEN_FILE' >&2
    exit 2
fi

need curl
need jq

zip_id=$(drive_id "$1")
destination_id=
if test "$#" -eq 2; then
    destination_id=$(drive_id "$2")
fi

temporary_root=${TMPDIR:-/tmp}
mkdir -p "$temporary_root"
temporary=$(mktemp -d "$temporary_root/cloud-storage-unzip.XXXXXX")
cleanup() {
    rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

umask 077
request=$temporary/request.json
response=$temporary/response.json
curl_config=$temporary/curl.conf

jq -n \
    --arg zip_id "$zip_id" \
    --arg destination_id "$destination_id" \
    '{
        function: "unzip_drive_file",
        parameters: [$zip_id, $destination_id],
        devMode: false
    }' > "$request"

# Keep the bearer token out of curl's argv and ordinary diagnostics.
printf 'header = "Authorization: Bearer %s"\n' "$token" > "$curl_config"
printf '%s\n' 'header = "Content-Type: application/json"' >> "$curl_config"

endpoint=https://script.googleapis.com/v1/scripts/$deployment_id:run
if ! curl \
    --config "$curl_config" \
    --fail-with-body \
    --silent \
    --show-error \
    --connect-timeout 20 \
    --max-time 370 \
    --request POST \
    --data-binary "@$request" \
    "$endpoint" > "$response"
then
    if test -s "$response"; then
        cat "$response" >&2
    fi
    exit 1
fi

if jq -e '.error? != null' "$response" >/dev/null; then
    jq -c '.error' "$response" >&2
    exit 1
fi

if ! jq -e '.done == true and .response.result != null' "$response" >/dev/null; then
    printf '%s\n' 'Apps Script returned no successful result' >&2
    jq -c '.' "$response" >&2
    exit 1
fi

jq -c '.response.result' "$response"
